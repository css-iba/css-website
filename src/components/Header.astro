---
import CubeLogo from './CubeLogo.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
---

<header class="header">
  <div class="container header-inner">
    <a href="#" class="brand-link" aria-label="CSS IBA Homepage">
      <CubeLogo size={36} glow={false} />
      <div class="brand-text">
        <span class="brand-acronym font-display">CSS</span>
        <span class="brand-sub font-body">IBA KARACHI</span>
      </div>
    </a>

    <div class="header-actions">
      <Badge variant="magenta" size="sm" font="body" class="sys-badge">
        <span class="pulse-dot"></span> 2026–2027 ONLINE
      </Badge>
      <Button href="#join" variant="primary" size="sm"> JOIN NOW </Button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(5, 5, 8, 0.95);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 66px;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1;
  }

  .brand-acronym {
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .brand-sub {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--accent-magenta);
    letter-spacing: 0.12em;
    margin-top: 2px;
    opacity: 0.95;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pulse-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 6px #22c55e;
    animation: pulse 1.8s infinite;
    margin-right: 0.35rem;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.25);
      opacity: 1;
    }
    100% {
      transform: scale(0.95);
      opacity: 0.8;
    }
  }

  @media (max-width: 640px) {
    .sys-badge {
      display: none;
    }
  }
</style>
