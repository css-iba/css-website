---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'IBA Computer Science Society',
  description = 'The official Computer Science Society at IBA Karachi. Open to all academic programs across campus for Session 2026-2027.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/css-cube.png" />
    <link rel="apple-touch-icon" href="/images/css-cube.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060608" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:site_name"
      content="Computer Science Society - IBA Karachi"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Handjet:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700;800&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
