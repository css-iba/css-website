---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'terminal' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  target?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  target,
  type = 'button',
  disabled = false,
  class: className = '',
} = Astro.props;

const Tag = disabled ? 'button' : href ? 'a' : 'button';
---

<Tag
  href={!disabled ? href : undefined}
  target={!disabled ? target : undefined}
  type={!href || disabled ? type : undefined}
  disabled={disabled}
  aria-disabled={disabled}
  class={`btn btn-${variant} btn-${size} ${disabled ? 'btn-disabled' : ''} ${className}`}
>
  <span class="btn-content">
    <slot />
  </span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    font-family: var(--font-body);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.25s ease;
    outline: none;
    border: none;
    line-height: 1;
    overflow: hidden;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  .btn-md {
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
  }

  .btn-lg {
    padding: 1rem 2rem;
    font-size: 1.05rem;
  }

  .btn-content {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    z-index: 2;
  }

  .btn-primary {
    background: var(--bg-panel);
    color: var(--text-primary);
    border: 1px solid rgba(217, 70, 239, 0.4);
    box-shadow: 0 0 15px rgba(124, 42, 232, 0.2);
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gradient-brand);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .btn-primary:hover:not(.btn-disabled) {
    border-color: var(--accent-pink);
    box-shadow: 0 0 25px rgba(236, 72, 153, 0.45);
    transform: translateY(-2px);
    color: #ffffff;
  }

  .btn-primary:hover:not(.btn-disabled)::before {
    opacity: 0.15;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-secondary:hover:not(.btn-disabled) {
    background: var(--bg-panel-hover);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .btn-terminal {
    font-family: var(--font-tech);
    font-size: 1.1rem;
    background: #09090e;
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.7rem 1.2rem;
  }

  .btn-terminal:hover:not(.btn-disabled) {
    background: rgba(56, 189, 248, 0.12);
    border-color: #38bdf8;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);
  }

  .btn-outline {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-outline:hover:not(.btn-disabled) {
    border-color: var(--accent-violet);
    box-shadow: 0 0 15px rgba(124, 42, 232, 0.25);
    color: #ffffff;
  }

  .btn-disabled,
  .btn:disabled {
    background: rgba(255, 255, 255, 0.03) !important;
    color: #52525b !important;
    border: 1px dashed rgba(255, 255, 255, 0.12) !important;
    box-shadow: none !important;
    cursor: not-allowed !important;
    opacity: 0.65;
    pointer-events: none;
    transform: none !important;
  }
</style>
